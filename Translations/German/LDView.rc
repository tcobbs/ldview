IDR_MAIN_MENU MENU
BEGIN
    POPUP "&Datei"
    BEGIN
        MENUITEM "&Öffnen...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "Bild &speichern...\tCtrl+S",    ID_FILE_SAVE
        MENUITEM "E&xportieren...\tCtrl+X",       ID_FILE_EXPORT
        MENUITEM "&Neu laden\tF5",                ID_FILE_RELOAD
        MENUITEM "&Laden abbrechen\tEsc",         ID_FILE_CANCELLOAD
        MENUITEM SEPARATOR
        POPUP "&Abfragen"
        BEGIN
            MENUITEM "&Deaktiviert",                         ID_FILE_POLLING_DISABLED
            MENUITEM "&Nachfragen",                          ID_FILE_POLLING_PROMPT
            MENUITEM "&Automatisch aktualisieren wenn aktiv",ID_FILE_POLLING_AUTO
            MENUITEM "&Sofort automatisch aktualisieren",    ID_FILE_POLLING_BACKGROUND
        END
        MENUITEM "Nach Bauteile-&Updates suchen...",    ID_FILE_CHECKFORLIBUPDATES
        MENUITEM SEPARATOR
        MENUITEM "Seite &einrichten...",                ID_FILE_PAGESETUP
        MENUITEM "&Drucken...\tCtrl+P",                 ID_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "&Beenden\tCtrl+Q",                    ID_FILE_EXIT
    END
    POPUP "&Bearbeiten"
    BEGIN
        MENUITEM "&Einstellungen...\tCtrl+Shift+V", ID_EDIT_PREFERENCES
    END
    POPUP "&Ansicht"
    BEGIN
        MENUITEM "V&erwende visuellen Stil (Erfordert Neustart)", ID_VIEW_VISUALSTYLE
        MENUITEM "V&ollbild\tCtrl+Enter",            ID_VIEW_FULLSCREEN
        MENUITEM "Symbolleis&te\tCtrl+Shift+T",      ID_VIEW_TOOLBAR
        MENUITEM "&Statusleiste\tCtrl+Shift+S",      ID_VIEW_STATUSBAR
        MENUITEM "&Immer im &Vordergrund",           ID_VIEW_ALWAYSONTOP
        MENUITEM "Ansicht zurüc&ksetzen\tCtrl+A",    ID_VIEW_RESET
        MENUITEM "&Zoom anpassen\tCtrl+Z",           ID_VIEW_ZOOMTOFIT
        MENUITEM "Aufrecht ausrichten\tCtrl+U",            ID_VIEW_RIGHTSIDEUP
        MENUITEM "Kamera-Position",             ID_VIEW_CAMERALOCATION
        MENUITEM "Rotationszentrum",             ID_VIEW_ROTATIONCENTER
        POPUP "&Ansichtswinkel"
        BEGIN
            MENUITEM "&Vorne\tCtrl+1",               ID_VIEW_FRONT
            MENUITEM "&Hinten\tCtrl+2",              ID_VIEW_BACK
            MENUITEM "&Links\tCtrl+3",               ID_VIEW_LEFT
            MENUITEM "&Rechts\tCtrl+4",              ID_VIEW_RIGHT
            MENUITEM "&Oben\tCtrl+5",                ID_VIEW_TOP
            MENUITEM "&Unten\tCtrl+6",             ID_VIEW_BOTTOM
            MENUITEM "Latitude/Longitude &bestimmen\tCtrl+9", ID_VIEW_SPECIFYLATLON
            MENUITEM "&Isometrisch\tCtrl+0",         ID_VIEW_ISO
            MENUITEM SEPARATOR
            MENUITEM "&Akt. Ansicht als Standard speichern",    ID_VIEW_SAVE_DEFAULT
        END
        POPUP "Standard &Fenstergrößen"
        BEGIN
            MENUITEM "Dummy item",                  ID_VIEW_STANDARDSIZES_DUMMYITEM
        END
        MENUITEM SEPARATOR
        MENUITEM "&Prüfungsmodus\tCtrl+Shift+P", ID_VIEW_EXAMINE
        MENUITEM "&Latitude/Longitude Rotation", ID_VIEW_EXAMINE_LAT_LONG
        MENUITEM "Schwenk&modus\tCtrl+Shift+M", ID_VIEW_FLYTHROUGH
        MENUITEM "Aufrecht halten",          ID_VIEW_KEEPRIGHTSIDEUP
        MENUITEM "&Gehmodus\tCtrl+Shift+W", ID_VIEW_WALK
        MENUITEM SEPARATOR
    END
    POPUP "&Schritt"
    BEGIN
        MENUITEM "&Erster\tPos.1",              ID_FIRST_STEP
        MENUITEM "&Vorheriger\tBildAuf",        ID_PREV_STEP
        MENUITEM "&Nächster\tBildAb",           ID_NEXT_STEP
        MENUITEM "&Letzter\tEnde",              ID_LAST_STEP
        MENUITEM SEPARATOR
        MENUITEM "&Gehe zu Schritt\tStrg+G",    ID_GOTO_STEP
    END
    POPUP "&Extras"
    BEGIN
        MENUITEM "&Fehler && Warnungen...\tCtrl+F", ID_TOOLS_ERRORS
        MENUITEM "Bauteile&liste...\tCtrl+L",   ID_TOOLS_PARTSLIST
        MENUITEM "&Modellbaum...\tCtrl+M",      ID_TOOLS_MODELTREE
        MENUITEM "Modell-&Gitterbox...\tCtrl+Shift+G", ID_TOOLS_BOUNDINGBOX
        MENUITEM "MP&D Modell auswählen...\tCtrl+D", ID_TOOLS_MPD
        MENUITEM "Statistik...\tCtrl+Shift+S", ID_TOOLS_STATISTICS
        MENUITEM SEPARATOR
        MENUITEM "Zeige Ansichts&informationen...", ID_TOOLS_VIEW_INFO
        MENUITEM SEPARATOR
        MENUITEM "Zeige &POV-Ray Kamera-Information...", ID_TOOLS_POV_CAMERA
        MENUITEM "Verwende aktuelles &Seitenverhältnis für POV-Ray", ID_TOOLS_POV_CAMERA_ASPECT
    END
    POPUP "&Hilfe"
    BEGIN
        MENUITEM "&OpenGL-Treiber Information...", ID_HELP_OPENGL_INFO
        MENUITEM SEPARATOR
        MENUITEM "&Inhalt...\tF1",              ID_HELP_CONTENTS
        MENUITEM "&Über LDView...",             ID_HELP_ABOUT
    END
END

IDR_TOOLBAR_MENU MENU
BEGIN
    POPUP "Drahtgitter"
    BEGIN
        MENUITEM "Haupt",                        ID_TBCONTEXT_MAIN
        MENUITEM "Schritte",                       ID_TBCONTEXT_STEPS
        MENUITEM SEPARATOR
        MENUITEM "Anpassen...",                ID_TBCONTEXT_CUSTOMIZE
    END
    POPUP "Kanten"
    BEGIN
        MENUITEM "Nebel",                         ID_WIREFRAME_FOG
        MENUITEM "Verdeckte Linien verstecken",         ID_WIREFRAME_REMOVEHIDDENLINES
    END
    POPUP "Kanten", CHECKED
    BEGIN
        MENUITEM "Zeige nur Kanten",            ID_EDGES_SHOWEDGESONLY
        MENUITEM "Optionale Linien",            ID_EDGES_CONDITIONALLINES
        MENUITEM "Hohe Qualität",               ID_EDGES_HIGHQUALITY
        MENUITEM "Immer schwarz",               ID_EDGES_ALWAYSBLACK
    END
    POPUP "Grundelemente"
    BEGIN
        MENUITEM "Knopf mit Textur",            ID_PRIMITIVES_TEXTURESTUDS
        MENUITEM "Texturen verwenden",            ID_PRIMITIVES_TEXMAPS
    END
    POPUP "Beleuchtung"
    BEGIN
        MENUITEM "Hohe Qualität",               ID_LIGHTING_HIGHQUALITY
        MENUITEM "Gedimmt",                     ID_LIGHTING_SUBDUED
        MENUITEM "Glanzlicht",                  ID_LIGHTING_SPECULARHIGHLIGHT
        MENUITEM "Alternative Beleuchtung",     ID_LIGHTING_ALTERNATESETUP
        MENUITEM "Verwende LIGHT.DAT Lichter",  ID_LIGHTING_DRAWDATS
        MENUITEM "Ersetze Standardlicht",       ID_LIGHTING_OPTIONALMAIN
    END
    POPUP "BFC"
    BEGIN
        MENUITEM "Rote Rückseiten",              ID_BFC_REDBACKFACES
        MENUITEM "Grüne Vorderseiten",           ID_BFC_GREENFRONTFACES
        MENUITEM "Blaue Neutralseiten",          ID_BFC_BLUENEUTRALFACES
    END
END


