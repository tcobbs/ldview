/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Apri...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&Salva immagine…\tCtrl+S",   ID_FILE_SAVE
        MENUITEM "Esp&orta...\tCtrl+E",          ID_FILE_EXPORT
        MENUITEM "&Ricarica\tF5",                 ID_FILE_RELOAD
        MENUITEM "A&nnulla caricamento\tEsc",           ID_FILE_CANCELLOAD
        MENUITEM SEPARATOR
        POPUP "&Interrogazione"
        BEGIN
            MENUITEM "&Disattivato",                   ID_FILE_POLLING_DISABLED
            MENUITEM "&Richiedi",                     ID_FILE_POLLING_PROMPT
            MENUITEM "Aggiornamento automatico se &attivo",    ID_FILE_POLLING_AUTO
            MENUITEM "Aggiornamento &immediato",    ID_FILE_POLLING_BACKGROUND
        END
        MENUITEM "Cerca aggiornamenti libreria...", ID_FILE_CHECKFORLIBUPDATES
        MENUITEM SEPARATOR
        MENUITEM "Imposta pa&gina...",              ID_FILE_PAGESETUP
        MENUITEM "Stam&pa...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "&Esci\tCtrl+Q",               ID_FILE_EXIT
    END
    POPUP "&Modifica"
    BEGIN
        MENUITEM "&Proprietà...\tCtrl+Shift+P", ID_EDIT_PREFERENCES
    END
    POPUP "&Visualizza"
    BEGIN
        MENUITEM "&Usa stile visuale (richiede invio)", ID_VIEW_VISUALSTYLE
        MENUITEM "Schermo &intero\tCtrl+Enter", ID_VIEW_FULLSCREEN
        MENUITEM "Barra degli s&trumenti\tCtrl+Shift+T",      ID_VIEW_TOOLBAR
        MENUITEM "Barra di &stato\tCtrl+Shift+S",   ID_VIEW_STATUSBAR
        MENUITEM "Se&mpre in primo piano",              ID_VIEW_ALWAYSONTOP
        MENUITEM "&Ripristina vista\tCtrl+R",         ID_VIEW_RESET
        MENUITEM "&Adatta zoom\tCtrl+F",        ID_VIEW_ZOOMTOFIT
        MENUITEM "Raddrizza\tCtrl+U",       ID_VIEW_RIGHTSIDEUP
        MENUITEM "Posizione fotocamera",             ID_VIEW_CAMERALOCATION
        MENUITEM "Centro di rotazione",             ID_VIEW_ROTATIONCENTER
        POPUP "An&goli di visione"
        BEGIN
            MENUITEM "&Fronte\tCtrl+1",              ID_VIEW_FRONT
            MENUITEM "&Retro\tCtrl+2",               ID_VIEW_BACK
            MENUITEM "&Sinistra\tCtrl+3",               ID_VIEW_LEFT
            MENUITEM "&Destra\tCtrl+4",              ID_VIEW_RIGHT
            MENUITEM "&Alto\tCtrl+5",                ID_VIEW_TOP
            MENUITEM "&Basso\tCtrl+6",             ID_VIEW_BOTTOM
            MENUITEM "Specifica latitudine/lo&ngitudine\tCtrl+9", ID_VIEW_SPECIFYLATLON
            MENUITEM "&Isometrico\tCtrl+0",         ID_VIEW_ISO
            MENUITEM SEPARATOR
            MENUITEM "Salva &vista come predefinita",    ID_VIEW_SAVE_DEFAULT
        END
        POPUP "Dime&nsioni standard"
        BEGIN
            MENUITEM "Dummy item",                  ID_VIEW_STANDARDSIZES_DUMMYITEM
        END
        MENUITEM SEPARATOR
        MENUITEM "M&odalità esame\tCtrl+Shift+X", ID_VIEW_EXAMINE
        MENUITEM "Rotazione la&titudine/longitudine", ID_VIEW_EXAMINE_LAT_LONG
        MENUITEM "Modalità &panoramica\tCtrl+Shift+F", ID_VIEW_FLYTHROUGH
        MENUITEM "Mantieni raddrizzato",          ID_VIEW_KEEPRIGHTSIDEUP
        MENUITEM "Modalità &camminata\tCtrl+Shift+W", ID_VIEW_WALK
        MENUITEM SEPARATOR
    END
    POPUP "&Passo"
    BEGIN
        MENUITEM "&Primo\tHome",                ID_FIRST_STEP
        MENUITEM "P&recedente\tPgUp",             ID_PREV_STEP
        MENUITEM "&Successivo\tPgDn",                 ID_NEXT_STEP
        MENUITEM "&Ultimo\tEnd",                  ID_LAST_STEP
        MENUITEM SEPARATOR
        MENUITEM "&Vai al passo...\tCtrl+G",      ID_GOTO_STEP
    END
    POPUP "&Extra"
    BEGIN
        MENUITEM "&Errori && avvisi... \tCtrl+Shift+E", ID_TOOLS_ERRORS
        MENUITEM "E&lenco Parts...\tCtrl+L",      ID_TOOLS_PARTSLIST
        MENUITEM "S&truttura modello...\tCtrl+T",      ID_TOOLS_MODELTREE
        MENUITEM "&Bounding box del modello...\tCtrl+B", ID_TOOLS_BOUNDINGBOX
        MENUITEM "Selezione modello MP&D...\tCtrl+M", ID_TOOLS_MPD
        MENUITEM "Statistiche...\tCtrl+Shift+S", ID_TOOLS_STATISTICS
        MENUITEM SEPARATOR
        MENUITEM "&Mostra informazioni di vista...",          ID_TOOLS_VIEW_INFO
        MENUITEM SEPARATOR
        MENUITEM "Mostra informazioni &fotocamera POV-Ray...", ID_TOOLS_POV_CAMERA
        MENUITEM "&Usa rapporto d'aspetto attuale per la fotocamera POV-Ray", ID_TOOLS_POV_CAMERA_ASPECT
    END
    POPUP "&Guida"
    BEGIN
        MENUITEM "Informazione Driver &OpenGL...",      ID_HELP_OPENGL_INFO
        MENUITEM SEPARATOR
        MENUITEM "&Contenuto...\tF1",            ID_HELP_CONTENTS
        MENUITEM "&Informazioni su LDView…",            ID_HELP_ABOUT
    END
END

IDR_TOOLBAR_MENU MENU
BEGIN
    POPUP "Wireframe"
    BEGIN
        MENUITEM "Principale",                        ID_TBCONTEXT_MAIN
        MENUITEM "Passi",                       ID_TBCONTEXT_STEPS
        MENUITEM SEPARATOR
        MENUITEM "Personalizza...",                ID_TBCONTEXT_CUSTOMIZE
    END
    POPUP "Bordi"
    BEGIN
        MENUITEM "Nebbia",                         ID_WIREFRAME_FOG
        MENUITEM "Rimuovi bordi nascosti",         ID_WIREFRAME_REMOVEHIDDENLINES
    END
    POPUP "Bordi", CHECKED
    BEGIN
        MENUITEM "Mostra solo bordi",             ID_EDGES_SHOWEDGESONLY
        MENUITEM "Linee di costruzione",           ID_EDGES_CONDITIONALLINES
        MENUITEM "Alta qualità",                ID_EDGES_HIGHQUALITY
        MENUITEM "Sempre nero",                ID_EDGES_ALWAYSBLACK
    END
    POPUP "Primitivi"
    BEGIN
        MENUITEM "Trama studs",               ID_PRIMITIVES_TEXTURESTUDS
        MENUITEM "Usa texture",            ID_PRIMITIVES_TEXMAPS
    END
    POPUP "Illuminazione"
    BEGIN
        MENUITEM "Alta qualità",                ID_LIGHTING_HIGHQUALITY
        MENUITEM "Luce soffusa",                     ID_LIGHTING_SUBDUED
        MENUITEM "Luce speculare",          ID_LIGHTING_SPECULARHIGHLIGHT
        MENUITEM "Impostazione alternativa",             ID_LIGHTING_ALTERNATESETUP
        MENUITEM "Usa luci LIGHT.DAT",        ID_LIGHTING_DRAWDATS
        MENUITEM "Sostituisci luce principale",          ID_LIGHTING_OPTIONALMAIN
    END
    POPUP "BFC"
    BEGIN
        MENUITEM "Lati posteriori in rosso",              ID_BFC_REDBACKFACES
        MENUITEM "Lati frontali in verde",           ID_BFC_GREENFRONTFACES
        MENUITEM "Lati neutri in blu",          ID_BFC_BLUENEUTRALFACES
    END
END


