IDD_ABOUT_BOX DIALOGEX 0, 0, 245, 194
STYLE DS_SETFONT | DS_MODALFRAME | DS_SETFOREGROUND | DS_3DLOOK | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Informazioni su LDView"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,188,7,50,15,BS_NOTIFY
    ICON            IDI_APP_ICON,IDC_STATIC,15,10,20,20
    LTEXT           "LDView %s (%s) (%s)\n%s",IDC_VERSION_LABEL,50,10,135,28,SS_NOPREFIX
    LTEXT           "Un ringraziamento speciale alle seguenti persone per aver contribuito a LDView (in ordine alfabetico):",IDC_STATIC,15,40,215,20
    LTEXT           "LEGO® e il logo LEGO sono marchi registrati del Gruppo LEGO, che non sponsorizza, approva né autorizza questo programma.",IDC_STATIC,13,168,219,17
    GROUPBOX        "",IDC_STATIC,0,161,245,30
    LTEXT           "",IDC_STATIC,0,160,8,36,0,WS_EX_TRANSPARENT
    LTEXT           "",IDC_STATIC,237,160,8,36,0,WS_EX_TRANSPARENT
    LTEXT           "",IDC_STATIC,0,186,245,8,0,WS_EX_TRANSPARENT
    LTEXT           "Chris Conley\nLars C. Hassing\nDon Heyse\nRusty Larner\nAlex Raftis\nCarsten Schmitz\nWilly Tschager\nMartijn Zwaal\n\nJean-loup Gailly, Mark Adler",IDC_STATIC,25,61,203,84
    LTEXT           "Jean-loup Gailly, Mark Adler, ed agli altri del zlib team\nGlenn Randers-Pehrson ed agli altri del libpng team",IDC_STATIC,25,145,203,18
END

