IDR_MAIN_MENU MENU
BEGIN
    POPUP "&Soubor"
    BEGIN
        MENUITEM "&Otevřít…\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&Uložit obrázek…\tCtrl+S",   ID_FILE_SAVE
        MENUITEM "&Exportovat...\tCtrl+E",          ID_FILE_EXPORT
        MENUITEM "Ob&novit\tF5",                 ID_FILE_RELOAD
        MENUITEM "&Zrušit načítání\tEsc",           ID_FILE_CANCELLOAD
        MENUITEM SEPARATOR
        POPUP "&Aut. obnovování"
        BEGIN
            MENUITEM "&Vypnuto",                   ID_FILE_POLLING_DISABLED
            MENUITEM "&Upozornit",                     ID_FILE_POLLING_PROMPT
            MENUITEM "&Automaticky - při aktivaci",    ID_FILE_POLLING_AUTO
            MENUITEM "Automaticky - &okamžitě",    ID_FILE_POLLING_BACKGROUND
        END
        MENUITEM "Aktualizace knihovny LDraw",   ID_FILE_CHECKFORLIBUPDATES
        MENUITEM SEPARATOR
        MENUITEM "Vzhled stránk&y…",              ID_FILE_PAGESETUP
        MENUITEM "&Tisk…\tCtrl+P",           ID_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "&Konec\tCtrl+Q",               ID_FILE_EXIT
    END
    POPUP "Úpr&avy"
    BEGIN
        MENUITEM "&Nastavení…\tCtrl+Shift+P", ID_EDIT_PREFERENCES
    END
    POPUP "&Zobrazení"
    BEGIN
        MENUITEM "Použít &motiv vzhledu (vyžaduje restart)", ID_VIEW_VISUALSTYLE
        MENUITEM "Celo&obrazovkový režim\tCtrl+Enter", ID_VIEW_FULLSCREEN
        MENUITEM "Panel &nástrojů\tCtrl+Shift+T",      ID_VIEW_TOOLBAR
        MENUITEM "&Stavový řádek\tCtrl+Shift+S",   ID_VIEW_STATUSBAR
        MENUITEM "&Vždy na vrchu",              ID_VIEW_ALWAYSONTOP
        MENUITEM "Výchozí po&hled\tCtrl+R",         ID_VIEW_RESET
        MENUITEM "Přizpůsobit &zvětšení\tCtrl+F",        ID_VIEW_ZOOMTOFIT
        MENUITEM "Narovnat\tCtrl+U",       ID_VIEW_RIGHTSIDEUP
        MENUITEM "Poloha kamery",             ID_VIEW_CAMERALOCATION
        MENUITEM "Střed otáčení",             ID_VIEW_ROTATIONCENTER
        POPUP "&Úhel pohledu"
        BEGIN
            MENUITEM "Z&epředu\tCtrl+1",              ID_VIEW_FRONT
            MENUITEM "&Zezadu\tCtrl+2",               ID_VIEW_BACK
            MENUITEM "Z&leva\tCtrl+3",               ID_VIEW_LEFT
            MENUITEM "Z&prava\tCtrl+4",              ID_VIEW_RIGHT
            MENUITEM "&Shora\tCtrl+5",                ID_VIEW_TOP
            MENUITEM "Z&dola\tCtrl+6",             ID_VIEW_BOTTOM
            MENUITEM "Zadat šíř&ku/délku\tCtrl+9", ID_VIEW_SPECIFYLATLON
            MENUITEM "Dvoutřet&inový\tCtrl+0",         ID_VIEW_ISO
            MENUITEM SEPARATOR
            MENUITEM "&Uložit aktuální pohled jako výchozí",    ID_VIEW_SAVE_DEFAULT
        END
        POPUP "Standardní ve&likosti"
        BEGIN
            MENUITEM "Dummy item",                  ID_VIEW_STANDARDSIZES_DUMMYITEM
        END
        MENUITEM SEPARATOR
        MENUITEM "P&rohlížecí režim\tCtrl+Shift+X", ID_VIEW_EXAMINE
        MENUITEM "R&otace podle šířky/délky", ID_VIEW_EXAMINE_LAT_LONG
        MENUITEM "Režim &průletu\tCtrl+Shift+F", ID_VIEW_FLYTHROUGH
        MENUITEM "Udržovat narovnané",          ID_VIEW_KEEPRIGHTSIDEUP
        MENUITEM "Režim &chůze\tCtrl+Shift+W", ID_VIEW_WALK
        MENUITEM SEPARATOR
    END
    POPUP "&Krok"
    BEGIN
        MENUITEM "&První\tHome",                ID_FIRST_STEP
        MENUITEM "Př&edchozí\tPgUp",             ID_PREV_STEP
        MENUITEM "&Další\tPgDn",                 ID_NEXT_STEP
        MENUITEM "Pos&lední\tEnd",                  ID_LAST_STEP
        MENUITEM SEPARATOR
        MENUITEM "&Jít na krok...\tCtrl+G",      ID_GOTO_STEP
    END
    POPUP "Nástro&je"
    BEGIN
        MENUITEM "&Chyby a varování…\tCtrl+Shift+E", ID_TOOLS_ERRORS
        MENUITEM "Seznam &dílů",      ID_TOOLS_PARTSLIST
        MENUITEM "&Strom modelu...\tCtrl+T",      ID_TOOLS_MODELTREE
        MENUITEM "&Ohraničující kvádr modelu...\tCtrl+B", ID_TOOLS_BOUNDINGBOX
        MENUITEM "Výběr modelu &MPD...\tCtrl+M", ID_TOOLS_MPD
        MENUITEM "Statistika...\tCtrl+Shift+S", ID_TOOLS_STATISTICS
        MENUITEM SEPARATOR
        MENUITEM "Informace o &pohledu...",          ID_TOOLS_VIEW_INFO
        MENUITEM SEPARATOR
        MENUITEM "Zobrazit nastavení POV-Ray &kamery...", ID_TOOLS_POV_CAMERA
        MENUITEM "Použít &aktuální poměr stran pro kameru POV-Ray", ID_TOOLS_POV_CAMERA_ASPECT
    END
    POPUP "&Nápověda"
    BEGIN
        MENUITEM "Informace o Open&GL driveru…",      ID_HELP_OPENGL_INFO
        MENUITEM SEPARATOR
        MENUITEM "&Témata nápovědy…\tF1",            ID_HELP_CONTENTS
        MENUITEM "&O programu LDView…",            ID_HELP_ABOUT
    END
END

IDR_TOOLBAR_MENU MENU
BEGIN
    POPUP "Drátové zobrazení"
    BEGIN
        MENUITEM "Hlavní",                        ID_TBCONTEXT_MAIN
        MENUITEM "Kroky",                       ID_TBCONTEXT_STEPS
        MENUITEM SEPARATOR
        MENUITEM "Přizpůsobit...",                ID_TBCONTEXT_CUSTOMIZE
    END
    POPUP "Hrany"
    BEGIN
        MENUITEM "Mlha",                         ID_WIREFRAME_FOG
        MENUITEM "Odstranit skryté hrany",         ID_WIREFRAME_REMOVEHIDDENLINES
    END
    POPUP "Hrany", CHECKED
    BEGIN
        MENUITEM "Pouze obrysy",             ID_EDGES_SHOWEDGESONLY
        MENUITEM "Podmíněné čáry",           ID_EDGES_CONDITIONALLINES
        MENUITEM "Vysoká kvalita",                ID_EDGES_HIGHQUALITY
        MENUITEM "Vždy černě",                ID_EDGES_ALWAYSBLACK
    END
    POPUP "Primitiva"
    BEGIN
        MENUITEM "Texturovat výstupky",               ID_PRIMITIVES_TEXTURESTUDS
        MENUITEM "Použít textury",            ID_PRIMITIVES_TEXMAPS
    END
    POPUP "Osvětlení"
    BEGIN
        MENUITEM "Vysoká kvalita",                ID_LIGHTING_HIGHQUALITY
        MENUITEM "Tlumené",                     ID_LIGHTING_SUBDUED
        MENUITEM "Zrcadlové odlesky",          ID_LIGHTING_SPECULARHIGHLIGHT
        MENUITEM "Náhradní nastavení",             ID_LIGHTING_ALTERNATESETUP
        MENUITEM "Použít světla LIGHT.DAT",        ID_LIGHTING_DRAWDATS
        MENUITEM "Nahradit hlavní světlo",          ID_LIGHTING_OPTIONALMAIN
    END
    POPUP "BFC"
    BEGIN
        MENUITEM "Zadní stěny červeně",              ID_BFC_REDBACKFACES
        MENUITEM "Přední stěny zeleně",           ID_BFC_GREENFRONTFACES
        MENUITEM "Neutrální stěny modře",          ID_BFC_BLUENEUTRALFACES
    END
END


