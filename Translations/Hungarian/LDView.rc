IDR_MAIN_MENU MENU
BEGIN
    POPUP "Állományok"
    BEGIN
        MENUITEM "Megnyitás...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "Pillanatkép mentése...\tCtrl+S",  ID_FILE_SAVE
        MENUITEM "&Exportálás...\tCtrl+E",              ID_FILE_EXPORT
        MENUITEM "Betöltés új&ra\tF5",              ID_FILE_RELOAD
        MENUITEM "Betöltés megszakítása\tEsc",      ID_FILE_CANCELLOAD
        MENUITEM SEPARATOR
        POPUP "Vá&ltozás figyelés"
        BEGIN
            MENUITEM "Letiltva",                    ID_FILE_POLLING_DISABLED
            MENUITEM "Rákérdez",                    ID_FILE_POLLING_PROMPT
            MENUITEM "&Automatikusan frissít ha aktív",    ID_FILE_POLLING_AUTO
            MENUITEM "Automatikusan frissít",       ID_FILE_POLLING_BACKGROUND
        END
        MENUITEM "Adatbázis frissítése",            ID_FILE_CHECKFORLIBUPDATES
        MENUITEM SEPARATOR
        MENUITEM "Old&al beállítás...",             ID_FILE_PAGESETUP
        MENUITEM "&Nyomtatás...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM SEPARATOR
        MENUITEM "Kilépés\tCtrl+Q",                 ID_FILE_EXIT
    END
    POPUP "Szerk&esztés"
    BEGIN
        MENUITEM "Beállítások...\tCtrl+Shift+P",    ID_EDIT_PREFERENCES
    END
    POPUP "Nézet"
    BEGIN
        MENUITEM "&Visual Style használata(újraindítás szükséges)", ID_VIEW_VISUALSTYLE
        MENUITEM "Teljes képernyős nézet\tCtrl+Enter", ID_VIEW_FULLSCREEN
        MENUITEM "Eszközsáv\tCtrl+Shift+T",         ID_VIEW_TOOLBAR
        MENUITEM "Állapotsáv\tCtrl+Shift+S",        ID_VIEW_STATUSBAR
        MENUITEM "Mindig legfelül",                 ID_VIEW_ALWAYSONTOP
        MENUITEM "Visszaáll alapértelmezett nézetre\tCtrl+R",         ID_VIEW_RESET
        MENUITEM "Teljes méretre nagyít\tCtrl+F",   ID_VIEW_ZOOMTOFIT
        MENUITEM "Jobb oldal felül\tCtrl+U",        ID_VIEW_RIGHTSIDEUP
        MENUITEM "Kamera helyzete",             ID_VIEW_CAMERALOCATION
        MENUITEM "Forgatás középpontja",             ID_VIEW_ROTATIONCENTER
        POPUP "Nézőpontok"
        BEGIN
            MENUITEM "Előröl\tCtrl+1",              ID_VIEW_FRONT
            MENUITEM "Hátulról\tCtrl+2",            ID_VIEW_BACK
            MENUITEM "Ba&lról\tCtrl+3",             ID_VIEW_LEFT
            MENUITEM "Jobbról\tCtrl+4",             ID_VIEW_RIGHT
            MENUITEM "Felülről\tCtrl+5",            ID_VIEW_TOP
            MENUITEM "Alulról\tCtrl+6",             ID_VIEW_BOTTOM
            MENUITEM "Szélesség/hosszúság megadása\tCtrl+9", ID_VIEW_SPECIFYLATLON
            MENUITEM "Kétharmados\tCtrl+0",         ID_VIEW_ISO
            MENUITEM SEPARATOR
            MENUITEM "Aktuális nézet alapértelmezettnek",    ID_VIEW_SAVE_DEFAULT
        END
        POPUP "Szabvány méretek"
        BEGIN
            MENUITEM "Dummy item",                  ID_VIEW_STANDARDSIZES_DUMMYITEM
        END
        MENUITEM SEPARATOR
        MENUITEM "&Körüljáró mód\tCtrl+Shift+X", ID_VIEW_EXAMINE
        MENUITEM "Szélesség/Hosszúság forgatás", ID_VIEW_EXAMINE_LAT_LONG
        MENUITEM "Átrepülő mód\tCtrl+Shift+F", ID_VIEW_FLYTHROUGH
        MENUITEM "Jobb oldal felül tartása",          ID_VIEW_KEEPRIGHTSIDEUP
        MENUITEM "Sétáló mód\tCtrl+Shift+W", ID_VIEW_WALK
        MENUITEM SEPARATOR
    END
    POPUP "Lépések"
    BEGIN
        MENUITEM "Első\tHome",                ID_FIRST_STEP
        MENUITEM "Előző\tPgUp",               ID_PREV_STEP
        MENUITEM "Következő\tPgDn",           ID_NEXT_STEP
        MENUITEM "Utolsó\tEnd",               ID_LAST_STEP
        MENUITEM SEPARATOR
        MENUITEM "&Ugrás...\tCtrl+G",         ID_GOTO_STEP
    END
    POPUP "Eszközök"
    BEGIN
        MENUITEM "Hibák és figyelmeztetések...\tCtrl+Shift+E", ID_TOOLS_ERRORS
        MENUITEM "Elem&lista",      ID_TOOLS_PARTSLIST
        MENUITEM "&Modellfa...\tCtrl+T",      ID_TOOLS_MODELTREE
        MENUITEM "Modell Befoglaló Doboz...\tCtrl+B", ID_TOOLS_BOUNDINGBOX
        MENUITEM "MPD Modell kiválasztás...\tCtrl+M", ID_TOOLS_MPD
        MENUITEM "Statisztika...\tCtrl+Shift+S", ID_TOOLS_STATISTICS
        MENUITEM SEPARATOR
        MENUITEM "Nézőpont &infó...",          ID_TOOLS_VIEW_INFO
        MENUITEM SEPARATOR
        MENUITEM "&POV-Ray kamera infó...", ID_TOOLS_POV_CAMERA
        MENUITEM "&Aktuális képarány használata a POV-Ray kamerához", ID_TOOLS_POV_CAMERA_ASPECT
    END
    POPUP "Segítség"
    BEGIN
        MENUITEM "&OpenGL meghajtó adatok...",  ID_HELP_OPENGL_INFO
        MENUITEM SEPARATOR
        MENUITEM "Tartalom...\tF1",             ID_HELP_CONTENTS
        MENUITEM "Névjegy...",                  ID_HELP_ABOUT
    END
END

